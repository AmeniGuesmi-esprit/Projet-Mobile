# Copy this file to .env and fill in real values. .env is never committed.

# console: prints e-mails in the server log (DEFAULT — no e-mail is sent).
# smtp:    real delivery through Gmail (requires a Google App Password).
EMAIL_MODE=console

# Only needed when EMAIL_MODE=smtp (leave empty for now).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# SQLite database file, relative to the server/ directory.
DB_PATH=./proxi_life.db

SERVER_PORT=8080
